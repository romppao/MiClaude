# --- Obligatorias ---
# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ringespana"

# --- Obligatoria en producción ---
# Dirección pública de la web (sin barra final). Se usa en los enlaces de los correos.
# En producción el servidor no arranca si falta.
APP_URL="http://localhost:3000"

# --- Correo electrónico ---
# Producción: proveedor Resend (https://resend.com). Hacen falta las dos variables.
# RESEND_API_KEY="re_..."
# MAIL_FROM="Ring España <avisos@su-dominio.es>"
# Desarrollo y pruebas: escribe los correos en el registro del servidor (los enlaces incluyen los tokens;
# no usar en producción). Fuera de producción es el comportamiento por defecto.
# MAIL_TRANSPORT="log"

# --- Cuenta del creador (docs/CREADOR.md) ---
# Correo electrónico de la cuenta del fundador: tiene todos los permisos de moderación, gestiona cuentas y moderadores
# y pide un segundo paso al entrar (aplicación de códigos o códigos de emergencia). Solo cuenta con el correo confirmado.
# CREADOR_CORREO="fundador@su-dominio.es"

# --- Entrar con Google (docs/GOOGLE.md) ---
# Credenciales del «ID de cliente OAuth» (aplicación web) de Google Cloud. Sin ellas, el botón «Continuar con Google» no aparece.
# Dirección de vuelta que hay que autorizar en Google: <APP_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID="…apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="…"

# --- Titular y privacidad (aparecen en /aviso-legal y /privacidad; obligatorios por el art. 10 LSSI; docs/LEGAL.md) ---
# TITULAR_NOMBRE="Nombre y apellidos o razón social del titular de Lona"
# TITULAR_NIF="NIF o CIF"
# TITULAR_DOMICILIO="Dirección postal completa"
# TITULAR_REGISTRO="Solo si es una sociedad: Registro Mercantil, tomo, folio y hoja"
# RESPONSABLE_NOMBRE="(antiguo; si no hay TITULAR_NOMBRE se usa este)"
# CONTACT_EMAIL="info@lonaclub.es"

# Cuántos proxies de confianza hay delante de la aplicación (1 = uno solo, p. ej. el balanceador del alojamiento). Se usa para leer la IP real
# de quien hace la petición en X-Forwarded-For sin fiarse de lo que escriba el propio cliente. Si pones un número mayor que el real,
# los límites por IP se podrían saltar con una cabecera inventada; si es menor, todo el mundo parecería venir de la misma IP.
# TRUSTED_PROXY_HOPS=1

# Laboratorio visual con datos ficticios: solo accesible si DEMO_MODE y EXPERIENCE_LAB valen "si".
# Mantener desactivado en producción. No interviene en cuentas ni votaciones reales.
# EXPERIENCE_LAB=no

# Clave del cron de noticias (/api/cron/noticias). Sin ella el endpoint responde 503. El mismo valor va en los secretos de GitHub (CRON_SECRET).
# CRON_SECRET="una-cadena-larga-y-aleatoria"
