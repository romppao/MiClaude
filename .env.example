# --- Obligatorias ---
# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ringespana"

# --- Obligatoria en producción ---
# Dirección pública de la web (sin barra final). Se usa en los enlaces de los correos.
# En producción el servidor no arranca si falta.
APP_URL="http://localhost:3000"

# --- Correo electrónico ---
# Producción: proveedor Resend (https://resend.com). Hacen falta las dos variables.
# RESEND_API_KEY="re_..."
# MAIL_FROM="Ring España <avisos@su-dominio.es>"
# Desarrollo y pruebas: escribe los correos en el registro del servidor (los enlaces incluyen los tokens;
# no usar en producción). Fuera de producción es el comportamiento por defecto.
# MAIL_TRANSPORT="log"

# --- Privacidad (aparece en /privacidad; los define quien despliega la aplicación) ---
# RESPONSABLE_NOMBRE="Nombre o razón social del responsable del tratamiento"
# CONTACT_EMAIL="privacidad@su-dominio.es"

# Cuántos proxies de confianza hay delante de la aplicación (1 = uno solo, p. ej. el balanceador del alojamiento). Se usa para leer la IP real
# de quien hace la petición en X-Forwarded-For sin fiarse de lo que escriba el propio cliente. Si pones un número mayor que el real,
# los límites por IP se podrían saltar con una cabecera inventada; si es menor, todo el mundo parecería venir de la misma IP.
# TRUSTED_PROXY_HOPS=1

# Dónde se guardan las fotos y banners de perfil (T-004). «db» (por defecto): en PostgreSQL, como hasta ahora.
# «s3» (almacén de objetos) llegará con la parte 2 de T-004, cuando el fundador apruebe el proveedor y cree la cuenta.
# IMAGE_STORE=db
