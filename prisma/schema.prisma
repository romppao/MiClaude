generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Level {
  PRO
  AMATEUR
}

enum Stance {
  ORTODOXO
  ZURDO
  AMBIDIESTRO
}

enum Result {
  A_WIN
  B_WIN
  DRAW
  NO_CONTEST
}

enum Method {
  KO
  TKO
  UD
  SD
  MD
  RTD
  DQ
  DRAW
  SUBMISSION
  POINTS
  ADVANTAGE
  NC
}

enum Role {
  FAN
  FIGHTER
  ORGANIZER
  ADMIN
}

// Origen y fiabilidad de un combate registrado.
// SELF_REPORTED: lo añadió un peleador; CONFIRMED: el rival lo confirmó;
// VERIFIED: lo validó un administrador/organizador/federación; DISPUTED: el rival o un admin lo rechazó.
enum Verification {
  SELF_REPORTED
  CONFIRMED
  VERIFIED
  DISPUTED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum Discipline {
  BOXEO
  MMA
  KICKBOXING
  K1
  JIUJITSU
}

enum EventStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Gym {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  city         String
  province     String
  address      String?
  website      String?
  verifiedAt   DateTime?
  verifiedNote String?
  fighters     Fighter[]
  trainers     Trainer[]

  @@index([province])
}

model Trainer {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  bio      String?
  gymId    String?
  gym      Gym?      @relation(fields: [gymId], references: [id])
  fighters Fighter[]
}

model Fighter {
  id            String              @id @default(cuid())
  slug          String              @unique
  firstName     String
  lastName      String
  alias         String?
  birthDate     DateTime?
  city          String?
  province      String?
  nationality   String              @default("España")
  stance        Stance?
  heightCm      Int?
  reachCm       Int?
  level         Level               @default(AMATEUR)
  // false = ficha creada por un tercero (rival) que aún no ha sido reclamada ni confirmada: no sale en listados ni buscadores.
  listed        Boolean             @default(true)
  hiddenAt      DateTime?
  bio           String?
  gymId         String?
  gym           Gym?                @relation(fields: [gymId], references: [id])
  trainerId     String?
  trainer       Trainer?            @relation(fields: [trainerId], references: [id])
  userId        String?             @unique
  user          User?               @relation(fields: [userId], references: [id])
  disciplines   FighterDiscipline[]
  auras         Aura[]
  followers     Follow[]
  claimRequests ClaimRequest[]
  boutsAsA      Bout[]              @relation("FighterA")
  boutsAsB      Bout[]              @relation("FighterB")
  createdAt     DateTime            @default(now())

  @@index([gymId])
  @@index([trainerId])
  @@index([listed])
  @@index([lastName, firstName])
  @@index([province])
}

model Event {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  date        DateTime
  discipline  Discipline  @default(BOXEO)
  level       Level
  venue       String
  city        String
  province    String
  promoter    String?
  ticketUrl   String?
  status      EventStatus @default(SCHEDULED)
  createdById String?
  organizerId String?
  organizer   User?       @relation("EventOrganizer", fields: [organizerId], references: [id])
  bouts       Bout[]

  @@index([discipline, date])
  @@index([organizerId])
  @@index([date])
  @@index([level, date])
  @@index([province])
}

model Bout {
  id           String       @id @default(cuid())
  eventId      String
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  order        Int          @default(0)
  fighterAId   String
  fighterA     Fighter      @relation("FighterA", fields: [fighterAId], references: [id])
  fighterBId   String
  fighterB     Fighter      @relation("FighterB", fields: [fighterBId], references: [id])
  weightClass  String?
  rounds       Int?
  result       Result?
  method       Method?
  endRound     Int?
  verification Verification @default(SELF_REPORTED)
  createdById  String?
  createdBy    User?        @relation("BoutCreator", fields: [createdById], references: [id])
  auras        Aura[]
  flags        String[]     @default([])
  evidenceUrl  String?
  // Pareja canónica (ids ordenados): impide registrar dos veces el mismo enfrentamiento en una velada, en cualquier esquina.
  pairKey      String?

  @@unique([eventId, pairKey])
  @@index([createdById])
  @@index([eventId])
  @@index([fighterAId])
  @@index([fighterBId])
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  name             String
  passwordHash     String
  role             Role              @default(FAN)
  notifyEmails     Boolean           @default(true)
  emailVerifiedAt  DateTime?
  createdAt        DateTime          @default(now())
  sessions         Session[]
  fighter          Fighter?
  boutsCreated     Bout[]            @relation("BoutCreator")
  auras            Aura[]
  emailTokens      EmailToken[]
  claimRequests    ClaimRequest[]
  organizerRequest OrganizerRequest?
  auditLogs        AuditLog[]
  reports          Report[]
  follows          Follow[]
  events           Event[]           @relation("EventOrganizer")
}

model Session {
  id        String   @id // sha256 del token de la cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

// Aura: reconocimiento del público a un peleador por su actuación en UN combate concreto.
// Una por persona, combate y peleador (se puede quitar). El total de aura ordena el ránking por disciplina y categoría.
model Aura {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fighterId String
  fighter   Fighter   @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  boutId    String
  bout      Bout      @relation(fields: [boutId], references: [id], onDelete: Cascade)
  comment   String?
  attended  Boolean   @default(false) // "lo vi en directo"
  hiddenAt  DateTime? // ocultada por un moderador
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, boutId, fighterId])
  @@index([fighterId])
  @@index([boutId])
}

// Token de un solo uso enviado por correo (se guarda el sha256, como en Session).
model EmailToken {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   @default("VERIFY") // VERIFY (confirmar el correo) | RESET (crear una contraseña nueva)
  expiresAt DateTime

  @@index([userId, kind])
  @@index([expiresAt])
}

// Un usuario FIGHTER pide que una ficha ya existente (sin dueño) pase a ser suya. Lo aprueba un moderador.
model ClaimRequest {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fighterId String
  fighter   Fighter       @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  message   String?
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())

  @@unique([userId, fighterId])
  @@index([status])
  @@index([fighterId])
}

// Solicitud para pasar a ser ORGANIZER (publicar veladas y carteles). La aprueba un moderador.
model OrganizerRequest {
  id         String        @id @default(cuid())
  userId     String        @unique
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgName    String
  message    String?
  status     RequestStatus @default(PENDING)
  reviewNote String?
  reviewedAt DateTime?
  createdAt  DateTime      @default(now())
}

// Historial de cambios: nada relevante se modifica en silencio. `before`/`after` guardan lo que cambió.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  entity    String // BOUT, EVENT, CLAIM, ORGANIZER, GYM…
  entityId  String
  action    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId])
}

// Aviso de un usuario sobre un dato que cree incorrecto (combate o ficha). Lo revisa un moderador.
model Report {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity         String // BOUT | FIGHTER
  entityId       String
  reason         String
  message        String?
  status         ReportStatus @default(OPEN)
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime     @default(now())

  @@index([status, createdAt])
  @@index([entity, entityId])
  @@index([userId])
}

// Un aficionado sigue a un peleador para ver sus próximas veladas y recibir avisos.
model Follow {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fighterId String
  fighter   Fighter  @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, fighterId])
  @@index([fighterId])
}

// Disciplinas que practica un peleador: categoría de peso y récord de partida (declarado por él) en cada una.
// Una sola ficha por persona; el récord registrado en la app se calcula aparte, a partir de los combates.
model FighterDiscipline {
  fighterId   String
  fighter     Fighter    @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  discipline  Discipline
  level       Level      @default(AMATEUR)
  weightClass String?
  // Récord de partida: combates anteriores a usar la app. Datos declarados, no comprobables.
  priorTotal  Int?
  priorWins   Int?
  priorLosses Int?
  priorDraws  Int?
  createdAt   DateTime   @default(now())

  @@id([fighterId, discipline])
  @@index([discipline, weightClass])
}

// Registro de intentos para limitar la frecuencia (inicio de sesión, registro, reenvíos…). Clave = acción + correo o IP.
model RateHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}
